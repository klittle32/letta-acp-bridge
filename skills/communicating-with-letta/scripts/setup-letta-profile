#!/usr/bin/env node

import { spawn } from "node:child_process";

const child = spawn("letta-acp-bridge", ["profile", "add", ...process.argv.slice(2)], {
  stdio: "inherit",
});
child.on("error", (error) => {
  console.error(`setup-letta-profile: cannot run letta-acp-bridge: ${error.message}`);
  process.exitCode = 2;
});
child.on("close", (code, signal) => {
  if (signal) process.kill(process.pid, signal);
  else process.exitCode = code ?? 1;
});
