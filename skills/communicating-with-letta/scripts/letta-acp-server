#!/usr/bin/env node

import { accessSync, constants } from "node:fs";
import { delimiter, join } from "node:path";
import { spawn } from "node:child_process";

function executableOnPath(name) {
  for (const directory of (process.env.PATH || "").split(delimiter)) {
    if (!directory) continue;
    const candidate = join(directory, name);
    try {
      accessSync(candidate, constants.X_OK);
      return candidate;
    } catch {
      // Keep searching.
    }
  }
  return null;
}

try {
  if (!process.env.LETTA_AGENT_ID) {
    throw new Error("LETTA_AGENT_ID must identify the persistent Letta agent to use");
  }
  process.env.LETTA_ACP_BACKEND ||= "cloud-oauth";
  process.env.LETTA_ACP_PERMISSION_MODE ||= "standard";

  let command = process.env.LETTA_ACP_SERVER_COMMAND;
  let args = [];
  if (command) {
    if (process.env.LETTA_ACP_SERVER_ARGS_JSON) {
      args = JSON.parse(process.env.LETTA_ACP_SERVER_ARGS_JSON);
      if (!Array.isArray(args) || args.some((arg) => typeof arg !== "string")) {
        throw new Error("LETTA_ACP_SERVER_ARGS_JSON must be an array of strings");
      }
    }
  } else {
    command = executableOnPath("letta-acp");
    if (!command) {
      command = "npx";
      args = ["-y", "@letta-ai/letta-acp"];
    }
  }

  const child = spawn(command, args, { env: process.env, stdio: "inherit" });
  for (const signal of ["SIGINT", "SIGTERM"]) {
    process.once(signal, () => child.kill(signal));
  }
  child.on("error", (error) => {
    console.error(`letta-acp-server: ${error.message}`);
    process.exitCode = 1;
  });
  child.on("close", (code, signal) => {
    if (signal) process.kill(process.pid, signal);
    else process.exitCode = code ?? 1;
  });
} catch (error) {
  console.error(`letta-acp-server: ${error.message}`);
  process.exitCode = 2;
}
